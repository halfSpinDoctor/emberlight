<Window x:Class="Emberlight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Emberlight.App.ViewModels"
        xmlns:core="clr-namespace:Emberlight.Core;assembly=Emberlight.Core"
        xmlns:ctl="clr-namespace:Emberlight.App.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Icon="Assets/app.ico"
        Title="Emberlight" Width="1100" Height="720" MinWidth="560" MinHeight="360"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" Drop="OnDrop">
    <!-- A solid, neutral background rather than Fluent's translucent Mica: the desktop wallpaper tinting the window
         would skew how photos look. -->

    <Window.Resources>
        <!-- Compact menus, matching the folder tree's 12 px text: Fluent's are 14 px text with a 49 px menu bar
             and 36 px items. Used by the menu bar (drop-downs included, and the Sort By items created in code) and the
             thumbnails' right-click menu. Fluent's templates hard-code their spacing, so OnMenuItemLoaded tightens it. -->
        <Style x:Key="CompactMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="FontSize" Value="12"/>
            <EventSetter Event="Loaded" Handler="OnMenuItemLoaded"/>
        </Style>

        <!-- Right-click on a thumbnail. Design rule: only items that are also in the menu bar, with the same names
             and handlers. Right-clicking an unselected thumbnail selects just it; inside a selection, keeps it. -->
        <ContextMenu x:Key="ThumbContextMenu" FontSize="12" Opened="OnThumbContextMenuOpened">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CompactMenuItem}"/>
            </ContextMenu.Resources>
            <MenuItem Header="_Copy To..." Click="OnCopyTo"/>
            <MenuItem Header="_Move To..." Click="OnMoveTo"/>
            <MenuItem Tag="Rename" Header="Re_name..." InputGestureText="F2" Click="OnRename"/>
            <Separator/>
            <MenuItem Header="Move to Recycle _Bin" InputGestureText="Del" Click="OnDelete"/>
        </ContextMenu>

        <!-- Right-click on a pinned folder. An exception to the menu-bar rule (decided with the user): managing pins
             happens where the pins are, so Rename Pin and Move Up / Move Down live only here. -->
        <ContextMenu x:Key="PinContextMenu" FontSize="12" Opened="OnPinContextMenuOpened">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CompactMenuItem}"/>
            </ContextMenu.Resources>
            <MenuItem Header="_Rename Pin..." InputGestureText="F2" Click="OnContextRenamePin"/>
            <MenuItem Header="_Unpin Folder" Click="OnContextTogglePin"/>
            <Separator/>
            <MenuItem Tag="Up" Header="Move _Up" Click="OnPinMoveUp"/>
            <MenuItem Tag="Down" Header="Move _Down" Click="OnPinMoveDown"/>
        </ContextMenu>

        <!-- Right-click on a folder in the tree: pins (or unpins) that folder without opening it. Also an exception to
             the menu-bar rule; the File menu's version works on the folder on screen. -->
        <ContextMenu x:Key="TreeContextMenu" FontSize="12" Opened="OnTreeContextMenuOpened">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CompactMenuItem}"/>
            </ContextMenu.Resources>
            <MenuItem Header="_Pin Folder" Click="OnContextTogglePin"/>
        </ContextMenu>

        <!-- Zero padding/border/minimum size so every cell is exactly CellWidth + 2*margin wide; the visible-range
             maths in ThumbnailGridMath relies on that. Based on the theme's own style (Fluent), which otherwise
             adds padding and a minimum height. -->
        <Style x:Key="ThumbContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ContextMenu" Value="{StaticResource ThumbContextMenu}"/>
        </Style>

        <DataTemplate x:Key="ThumbTemplate" DataType="{x:Type vm:ThumbnailItem}">
            <Border Margin="{x:Static vm:ViewSettings.CellMarginThickness}" Background="Transparent" ToolTip="{Binding ToolTipText}"
                    Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                    Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Bottom" Height="{x:Static core:ThumbnailGridMath.CaptionHeight}" Padding="2,2,2,0"
                               Text="{Binding FileName}" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               Visibility="{Binding DataContext.FilenameVisibility, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                           LayoutTransform="{Binding OrientationTransform}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ============================ menu ============================ -->
        <Menu DockPanel.Dock="Top" FontSize="12">
            <Menu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource CompactMenuItem}"/>
            </Menu.Resources>
            <MenuItem Header="_File" SubmenuOpened="OnFileMenuOpened">
                <MenuItem Header="_Open Folder..." InputGestureText="Ctrl+O" Click="OnOpenFolder"/>
                <!-- Filled in code (RebuildPins): each pin with its Ctrl+number, then Pin/Unpin Current Folder. -->
                <MenuItem x:Name="PinnedMenu" Header="_Pinned Folders"/>
                <Separator/>
                <MenuItem Header="Start _Slideshow" InputGestureText="Enter" Click="OnStartSlideshow"/>
                <MenuItem Header="Start Slideshow in a _Window" Click="OnStartSlideshowWindowed"/>
                <Separator/>
                <MenuItem Header="_Copy To..." Click="OnCopyTo"/>
                <MenuItem Header="_Move To..." Click="OnMoveTo"/>
                <MenuItem x:Name="MenuRename" Header="Re_name..." InputGestureText="F2" Click="OnRename"/>
                <MenuItem Header="Move to Recycle _Bin" InputGestureText="Del" Click="OnDelete"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Image">
                <MenuItem Header="Rotate _Left (EXIF tag)" Click="OnRotateLeft"/>
                <MenuItem Header="Rotate _Right (EXIF tag)" Click="OnRotateRight"/>
                <MenuItem Header="Reset Orientation _Tag" Click="OnResetOrientation"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="SortMenu" Header="_Sort By"/>
                <MenuItem x:Name="MenuShowFilenames" Header="Show _Filenames" IsCheckable="True" Click="OnToggleFilenames"/>
                <MenuItem x:Name="MenuSubfolders" Header="Include S_ubfolders" InputGestureText="Ctrl+F" IsCheckable="True" Click="OnToggleSubfolders"/>
                <Separator/>
                <MenuItem x:Name="MenuInfoPanel" Header="_Info Panel" InputGestureText="Ctrl+I" IsCheckable="True" Click="OnToggleInfoPanel"/>
                <MenuItem x:Name="MenuMoreExif" Header="More _EXIF Details" IsCheckable="True" Click="OnToggleMoreExif"/>
                <Separator/>
                <MenuItem Header="_Larger Thumbnails" InputGestureText="Ctrl++" Click="OnLarger"/>
                <MenuItem Header="S_maller Thumbnails" InputGestureText="Ctrl+-" Click="OnSmaller"/>
                <Separator/>
                <MenuItem Header="_Refresh" InputGestureText="F5" Click="OnRefresh"/>
            </MenuItem>
            <MenuItem Header="S_lideshow">
                <MenuItem x:Name="MenuLoop" Header="_Loop" IsCheckable="True" Click="OnSlideshowOption"/>
                <MenuItem x:Name="MenuRandom" Header="_Random Order" InputGestureText="Ctrl+S" IsCheckable="True" Click="OnSlideshowOption"/>
                <MenuItem x:Name="MenuScaleUp" Header="Scale Small Images _Up" IsCheckable="True" Click="OnSlideshowOption"/>
                <MenuItem x:Name="MenuActualSize" Header="Show _Actual Size" IsCheckable="True" Click="OnSlideshowOption"/>
                <MenuItem x:Name="MenuAutoAdvance" Header="Auto-_advance" IsCheckable="True" Click="OnSlideshowOption"/>
                <MenuItem x:Name="MenuFullScreen" Header="_Full Screen by Default" IsCheckable="True" Click="OnSlideshowOption"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Preferences..." Click="OnPreferences"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Emberlight" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- =========================== status bar =========================== -->
        <StatusBar DockPanel.Dock="Bottom" Padding="6,0">
            <StatusBar.Resources>
                <!-- Compact controls: Fluent gives checkboxes a 120 px minimum width and most controls a 32 px minimum
                     height, which made the status bar tall and spread the checkboxes apart. -->
                <Style TargetType="StatusBarItem" BasedOn="{StaticResource {x:Type StatusBarItem}}">
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>   <!-- line the labels up with "Size" -->
                    <Setter Property="Padding" Value="6,0,0,0"/>
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Height" Value="30"/>     <!-- Fluent's is 32; any shorter and the bottom of the thumb clips -->
                    <!-- Fluent draws the track a little below the slider's middle; lift it level with the labels -->
                    <Setter Property="RenderTransform">
                        <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                    </Setter>
                </Style>
            </StatusBar.Resources>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SlideshowButton" Content="Slideshow" Padding="14,1" Margin="0,0,16,0"
                            VerticalAlignment="Center" IsEnabled="False" Click="OnStartSlideshow"
                            ToolTip="Start a slideshow of the selected images, or of the whole folder (Enter)"/>
                    <CheckBox x:Name="SubfoldersCheck" Content="Subfolders" VerticalAlignment="Center"
                              Margin="0,0,14,0" Click="OnToggleSubfolders"
                              ToolTip="Show images from all folders below the selected one (Ctrl+F)"/>
                    <CheckBox x:Name="RandomCheck" Content="Random" VerticalAlignment="Center"
                              Margin="0,0,16,0" Click="OnToggleRandom"
                              ToolTip="Show slideshows in random order (Ctrl+S; press S during a slideshow to toggle it)"/>
                    <TextBlock Text="Size " VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Minimum="40" Maximum="400" Width="150" VerticalAlignment="Center"
                            Value="{Binding CellWidth, Mode=TwoWay}" SmallChange="10" LargeChange="40"
                            ToolTip="Thumbnail size"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem x:Name="BusyItem" Visibility="Collapsed">
                <ProgressBar x:Name="BusyBar" Width="130" Height="12" IsIndeterminate="True" Foreground="#C4561D"/>  <!-- fallback; normally the Windows accent colour, set in code -->
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ============================ content ============================ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="240" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="InfoColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Pinned folders, above the tree. Only shown while something is pinned; about six rows, then it scrolls.
                     The items are created in code (RebuildPins). Right-clicking doesn't select (that would open the pin). -->
                <ListBox x:Name="PinList" Grid.Row="0" Visibility="Collapsed" MaxHeight="142" Padding="0,2"
                         BorderThickness="0,0,1,0" BorderBrush="{Binding BorderBrush, ElementName=FolderTree}"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnPinSelected" PreviewMouseRightButtonDown="OnPinRightButtonDown"
                         PreviewKeyDown="OnPinKeyDown">
                    <ListBox.Resources>
                        <!-- Compact rows matching the tree's 12 px text and 22 px rows (Fluent's list items are taller). -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="ContextMenu" Value="{StaticResource PinContextMenu}"/>
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <!-- A thin line between the pins and the tree, in the same divider colour as the info panel's edge
                     (the tree's own border brush is invisible in Fluent). Shown and hidden with the pins. -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Visibility="{Binding Visibility, ElementName=PinList}"/>

                <TreeView x:Name="FolderTree" Grid.Row="2" BorderThickness="0,0,1,0"
                          SelectedItemChanged="OnFolderSelected"
                          PreviewMouseLeftButtonDown="OnTreePreviewMouseDown">
                    <TreeView.Resources>
                        <!-- Compact rows: Fluent's defaults are 14 px text in 28 px rows. The tree items are created in
                             code, so these apply through resource lookup. -->
                        <sys:Double x:Key="TreeViewItemFontSize">12</sys:Double>
                        <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                        <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="ContextMenu" Value="{StaticResource TreeContextMenu}"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <ListBox x:Name="ThumbList" Grid.Column="2" BorderThickness="0" SelectionMode="Extended"
                     ItemTemplate="{StaticResource ThumbTemplate}"
                     ItemContainerStyle="{StaticResource ThumbContainerStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnThumbDoubleClick"
                     PreviewKeyDown="OnThumbKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Virtualizing: only the visible rows get containers. Cell size comes from the same
                             ViewSettings that sizes the item template, so the two always agree. -->
                        <ctl:VirtualizingGridPanel
                            ItemWidth="{Binding DataContext.OuterCellWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            ItemHeight="{Binding DataContext.OuterCellHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Resizes the info panel, like the splitter beside the folder tree; hidden with the panel. -->
            <GridSplitter x:Name="InfoSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          Visibility="Collapsed"/>

            <Border x:Name="InfoPanel" Grid.Column="4" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="InfoHeader" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="10,10,10,4"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="InfoBody" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="6,0,6,6" Background="Transparent"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

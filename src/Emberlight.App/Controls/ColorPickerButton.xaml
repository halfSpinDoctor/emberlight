<UserControl x:Class="Emberlight.App.Controls.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A swatch button that opens a small colour picker under it. Its Text is bound two-way to a colour text box,
         so typing and picking stay in step; the picking logic (HSV, keeping the hue on greys) is ColorPickerModel in
         Core. The checkerboard, gradients and thumb rings are colour content, not UI chrome, so they are fixed
         colours; everything else uses Fluent's theme brushes. -->
    <UserControl.Resources>
        <!-- Light and dark grey squares, the usual way to show transparency. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White" Geometry="M0,0 H8 V8 H0 Z"/>
                    <GeometryDrawing Brush="#FFCCCCCC" Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PresetSwatch" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rim" CornerRadius="4" BorderThickness="1" Background="{StaticResource Checker}"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rim" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rim" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter TargetName="Rim" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Toggle" MinHeight="0" MinWidth="0" Padding="6,4" VerticalAlignment="Stretch"
                      AutomationProperties.Name="Pick a colour">
            <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="14" BorderThickness="1" Background="{StaticResource Checker}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Border x:Name="SwatchFill"/>
                        <!-- shown while the text box holds something that isn't a colour -->
                        <Path x:Name="InvalidMark" Data="M0,12 L22,0" Stroke="#FFD13438" StrokeThickness="1.5"
                              Stretch="Fill" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Path Data="M0,0 L4,4 L8,0" Margin="6,0,0,0" VerticalAlignment="Center" StrokeThickness="1.2"
                      Stroke="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Margin="0,4,8,8" Padding="10" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel x:Name="PickerRoot" Width="196" Focusable="True" FocusVisualStyle="{x:Null}">
                    <WrapPanel x:Name="PresetPanel" Margin="0,0,-4,0"/>

                    <!-- saturation left to right, brightness bottom to top -->
                    <Grid x:Name="SquareArea" Height="132" Margin="0,4,0,0" Cursor="Cross" Focusable="True"
                          AutomationProperties.Name="Saturation and brightness">
                        <Rectangle x:Name="SquareHue" Fill="Red"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Grid x:Name="SquareThumb" Width="12" Height="12">
                                <Ellipse Stroke="#99000000" StrokeThickness="1"/>
                                <Ellipse Margin="1" Stroke="White" StrokeThickness="2"/>
                            </Grid>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="HueBar" Height="14" Margin="0,8,0,0" Cursor="Hand" Focusable="True"
                          AutomationProperties.Name="Hue">
                        <Border CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                    <GradientStop Color="#00FF00" Offset="0.3333"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.6667"/>
                                    <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="HueThumb" Width="6" Height="18" Canvas.Top="-2" CornerRadius="2"
                                    BorderBrush="#99000000" BorderThickness="1">
                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="1"/>
                            </Border>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="AlphaBar" Height="14" Margin="0,8,0,0" Cursor="Hand" Focusable="True"
                          AutomationProperties.Name="Opacity">
                        <Border CornerRadius="3" Background="{StaticResource Checker}"/>
                        <Border x:Name="AlphaGradient" CornerRadius="3"/>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="AlphaThumb" Width="6" Height="18" Canvas.Top="-2" CornerRadius="2"
                                    BorderBrush="#99000000" BorderThickness="1">
                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="1"/>
                            </Border>
                        </Canvas>
                    </Grid>

                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Left" Width="32" Height="20" CornerRadius="3" BorderThickness="1"
                                Background="{StaticResource Checker}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Border x:Name="PreviewFill" CornerRadius="2"/>
                        </Border>
                        <TextBlock x:Name="HexText" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="You can also type #RRGGBB, #AARRGGBB (with transparency) or a colour name in the box."/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

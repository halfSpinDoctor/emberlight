<Window x:Class="Emberlight.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="Rename" Width="440" SizeToContent="Height" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontSize="12">
    <!-- 12 px text and slim fields, like Preferences. -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14,12,14,12">
        <TextBlock Text="New name:" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" TextChanged="OnNameChanged"/>
        <!-- Why the name can't be used; empty (but keeping its height, so the window doesn't jump) when it can. -->
        <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="16"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="RenameButton" Content="Rename" Width="76" IsDefault="True" Click="OnRename" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="76" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

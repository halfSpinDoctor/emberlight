<Window x:Class="Emberlight.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="Preferences" Width="520" Height="540" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}" FontSize="12">
    <Window.Resources>
        <!-- 12 px text, like the menus and folder tree (Fluent's is 14 px), with slimmer fields and group headings.
             Check box and radio button rows keep Fluent's 32 px height, which reads better than tighter rows;
             only the 120 px minimum width on check boxes goes, so "Descending" can sit beside the Sort by list. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Padding" Value="4,4,4,2"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="76" IsDefault="True" Click="OnOk" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="76" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="8">
                    <GroupBox Header="When Emberlight starts">
                        <StackPanel>
                            <RadioButton x:Name="StartLast" Content="Show the last folder I viewed" Margin="0,0,0,4"/>
                            <RadioButton x:Name="StartPictures" Content="Show this folder:" Margin="0,0,0,4"/>
                            <DockPanel Margin="20,0,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="10,2" Click="OnBrowsePictures"/>
                                <TextBox x:Name="PicturesPath"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Thumbnails" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="AutoRotate" Content="Rotate pictures upright using their EXIF orientation tag" Margin="0,0,0,4"/>
                            <CheckBox x:Name="PreserveModDate" Content="Keep the modified date when rotating files (EXIF tag edit)"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Opening files from Explorer" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="OpenDoSlideshow" Content="Start a slideshow when files are opened with Emberlight" Margin="0,0,0,4"/>
                            <CheckBox x:Name="OpenSubfolders" Content="Include subfolders when a folder is opened this way"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="View">
                <StackPanel Margin="8">
                    <GroupBox Header="Thumbnails">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SortFieldBox" Width="160"/>
                                <CheckBox x:Name="SortDescendingBox" Content="Descending" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowFilenames" Content="Show file names under thumbnails"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Folders" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="IncludeSubfolders" Content="Include subfolders" Margin="0,0,0,4"/>
                            <RadioButton x:Name="SubfoldersAlways" Content="Always" Margin="20,0,0,4"
                                         ToolTip="Include subfolders stays on until you switch it off"/>
                            <RadioButton x:Name="SubfoldersReset" Content="Reset when changing folder trees" Margin="20,0,0,0"
                                         ToolTip="Include subfolders stays on while you browse inside the folder where you switched it on, and switches off when you pick a folder outside it"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Info panel" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="InfoPanel" Content="Show the info panel" Margin="0,0,0,4"/>
                            <CheckBox x:Name="MoreExif" Content="More EXIF details" Margin="20,0,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Slideshow">
                <StackPanel Margin="8">
                    <CheckBox x:Name="FullScreen" Content="Full screen (otherwise in a window)" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="AutoAdvance" Content="Advance automatically every" VerticalAlignment="Center"/>
                        <TextBox x:Name="AutoSeconds" Width="50" Margin="6,0" TextAlignment="Right"/>
                        <TextBlock Text="seconds" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="Loop" Content="Loop back to the start after the last slide" Margin="0,0,0,4"/>
                    <CheckBox x:Name="RandomOrder" Content="Random order" Margin="0,0,0,4"/>
                    <CheckBox x:Name="Rerandomize" Content="Shuffle again each time a random slideshow loops" Margin="20,0,0,4"/>
                    <CheckBox x:Name="SuppressLoop" Content="Don't show the loop indicator" Margin="20,0,0,4"/>
                    <CheckBox x:Name="ScaleUp" Content="Scale small pictures up to fill the screen" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ActualSize" Content="Show pictures at actual size (100%)" Margin="0,0,0,4"/>
                    <CheckBox x:Name="FitWindow" Content="Windowed slideshow: size the window to the picture" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Background colour:" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="BackgroundColor" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Behind transparent pictures:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TransparentColor"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="e.g. #000000 or #00000000"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="File types">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Choose which file types appear in the browser. Formats are those Windows can decode out of the box."/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FileTypesPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

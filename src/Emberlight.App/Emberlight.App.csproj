<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>Emberlight.App</RootNamespace>
    <AssemblyName>Emberlight</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Icon shown in Explorer, the taskbar and Alt+Tab (the windows also use it; see the Resource item below) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Version and the details Windows shows under Properties > Details -->
    <Version>0.1.0</Version>
    <Product>Emberlight</Product>
    <AssemblyTitle>Emberlight</AssemblyTitle>
    <Description>Fast image browser and slideshow viewer - a Windows port of Phoenix Slides</Description>
    <Company>Emberlight contributors</Company>
    <Copyright>Windows port of Phoenix Slides by Dominic Yu (CC BY-NC-SA 2.0)</Copyright>

    <!-- Publishing: WPF's localized resource folders are not needed -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Application.ThemeMode (the Fluent theme, which follows dark mode) is still marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emberlight.Core\Emberlight.Core.csproj" />
  </ItemGroup>

</Project>
